# Server Port (Render provides process.env.PORT automatically)
PORT=5000

# Node Environment
NODE_ENV=production

# MongoDB Atlas Connection URI
# Retrieve from MongoDB Atlas -> Clusters -> Connect -> Drivers -> Node.js
# Example: mongodb+srv://<db_username>:<db_password>@cluster0.xxxx.mongodb.net/study_planner?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/study_planner?retryWrites=true&w=majority

# Secret key used for signing JWT tokens (use a long random alphanumeric string)
JWT_SECRET=super_secret_jwt_key_change_me_in_production_12345

# Allowed Client Origin for CORS (Your deployed Vercel frontend URL, e.g. https://your-project.vercel.app)
# You can also use * during initial testing or leave blank to accept Vercel domains automatically
CLIENT_URL=https://your-study-planner.vercel.app

# Optional: Google Gemini API key for dynamic AI chat responses
# If omitted, the backend falls back smoothly to its built-in academic content bank
GEMINI_API_KEY=your_gemini_api_key_here
